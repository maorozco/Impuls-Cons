# Postgres connection string. Use Neon free tier for dev: https://neon.tech
# On Replit: set this in Secrets, not in .env
DATABASE_URL="postgres://user:password@host:5432/biocycle"

# Public site URL (used for OG metadata and absolute links)
NEXT_PUBLIC_SITE_URL="https://biocycle.ai"

# Optional: Plausible Analytics domain (privacy-friendly alternative to GA)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# Optional: Calendly link for high-intent signups (used on thank-you page)
NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/your-handle/biocycle-discovery"
