# === Required ===

# Postgres connection string. Three profiles in order of preference:
#   Local Homebrew   → postgres://$USER@127.0.0.1:5432/biocycle (fastest for dev)
#   Neon free tier   → https://neon.tech (zero-ops cloud, 5-min cold-start wake)
#   Replit Secrets   → set DATABASE_URL in Secrets, never commit
# Bootstrap local: brew install postgresql@16 && brew services start postgresql@16
#                  createdb biocycle && pnpm exec drizzle-kit push --force
DATABASE_URL="postgres://user:password@host:5432/biocycle"

# Public site URL (used for OG metadata and absolute links)
NEXT_PUBLIC_SITE_URL="https://biocycle.ai"

# ml-api FastAPI address (server-side only — NOT NEXT_PUBLIC_*).
# Local dev and Replit prod both use loopback. Only override for split deploys.
ML_API_URL="http://127.0.0.1:5001"

# === Optional analytics & CRM ===

# Plausible Analytics domain (privacy-friendly alternative to GA)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# Calendly link surfaced on thank-you page when signup scores tier-green
NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/your-handle/biocycle-discovery"

# Separate Calendly link for the tier-verde (🟢) auto-email + thank-you CTA
CALENDLY_GREEN_LINK="https://calendly.com/your-handle/biocycle-tier-green"

# Resend API key for transactional mail (welcome, tier-green Calendly auto-send)
# https://resend.com/api-keys
RESEND_API_KEY=""
RESEND_FROM="hola@biocycle.ai"

# === Agents / research pipeline (Semana 1.6-1.7) ===

# Apify API token for Reddit scraper actor
# https://console.apify.com/account/integrations
APIFY_API_KEY=""

# Anthropic API key for classifier/synthesizer/chat RAG
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Basic auth for /admin/insights dashboard — format: user:bcrypt-hash
# Generate: htpasswd -nbB admin <password>
ADMIN_BASIC_AUTH=""

# Cache TTL for /api/insights endpoint (seconds)
INSIGHTS_CACHE_TTL_SECONDS=300

# === LLM provider chain ===
# Agents try providers in order until one returns text. Default chain in 'auto' mode:
#   Anthropic (production) → OpenRouter (dev, free tier) → Ollama (local fallback)
# Force a single provider with LLM_PROVIDER=anthropic|openrouter|ollama
LLM_PROVIDER="auto"

# OpenRouter keys (free tier models). Used when Anthropic rate-limits or fails.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=""
OPENROUTER_CLASSIFIER_MODEL="meta-llama/llama-3.3-70b-instruct:free"
OPENROUTER_SYNTHESIZER_MODEL="deepseek/deepseek-chat:free"
OPENROUTER_CHAT_MODEL="google/gemini-2.0-flash-exp:free"

# Ollama local fallback (runs free on your laptop — no network needed).
# Install: https://ollama.com  →  ollama pull qwen2.5:14b
# NOTE: Ollama 0.21 is broken on macOS Sequoia 26 (Metal API mismatch) — the
# provider chain automatically skips it when it throws, so you can keep it
# enabled safely.
OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_ENABLED="true"
OLLAMA_CLASSIFIER_MODEL="qwen2.5:14b"
OLLAMA_SYNTHESIZER_MODEL="qwen2.5:14b"
OLLAMA_CHAT_MODEL="qwen2.5:14b"
