{
  "name": "@workspace/agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-agent research pipeline for Impulso BioCycle (scraper, classifier, synthesizer, competitive, feeder).",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "scraper:dev": "AGENT_FIXTURE_MODE=true tsx scraper/main.ts",
    "scraper:live": "tsx scraper/main.ts",
    "classifier:dev": "AGENT_FIXTURE_MODE=true tsx classifier/main.ts",
    "classifier:live": "tsx classifier/main.ts",
    "synthesizer:dev": "AGENT_FIXTURE_MODE=true tsx synthesizer/main.ts",
    "synthesizer:live": "tsx synthesizer/main.ts",
    "competitive:dev": "AGENT_FIXTURE_MODE=true tsx competitive/main.ts",
    "competitive:live": "tsx competitive/main.ts",
    "feeder:dev": "AGENT_FIXTURE_MODE=true tsx feeder/main.ts",
    "feeder:live": "tsx feeder/main.ts",
    "pipeline:dev": "pnpm scraper:dev && pnpm classifier:dev && pnpm synthesizer:dev && pnpm competitive:dev && pnpm feeder:dev",
    "lint:banned": "tsx shared/lint-banned.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.1",
    "apify-client": "^2.11.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.36.4",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "sharp": "^0.34.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
