# === Agents pipeline — environment example ===

# Apify API token — https://console.apify.com/account/integrations
APIFY_API_KEY=""

# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Postgres connection (shared con landing; usar rol con write permissions)
DATABASE_URL=""

# Subreddits a minar (lista separada por comas) — default en shared/config.ts
SUBREDDITS_JSON=""

# Fixture mode: usa datos locales, no llama APIs externas. Útil en dev.
AGENT_FIXTURE_MODE="true"

# Optional — Slack webhook para digest diario del Competitive Intel Agent
SLACK_DIGEST_WEBHOOK=""

# Log level
LOG_LEVEL="info"

# OpenRouter — API OpenAI-compatible con muchos LLMs (incluye modelos gratis).
# Útil en dev. Para producción, preferir Anthropic directo.
OPENROUTER_API_KEY=""
LLM_PROVIDER="auto"           # "anthropic" | "openrouter" | "auto"
OPENROUTER_CLASSIFIER_MODEL="openai/gpt-oss-120b:free"
OPENROUTER_SYNTHESIZER_MODEL="openrouter/free"
OPENROUTER_FEEDER_MODEL="openrouter/free"
OPENROUTER_CHAT_MODEL="openrouter/free"
