# === Impulso BioCycle (Streamlit) — environment example ===

# Anthropic API key used by the RAG chat replacing keyword-matching (Semana 2.5)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Voyage AI embeddings for RAG ingestion (alternative: OpenAI text-embedding-3)
# https://dash.voyageai.com/
VOYAGE_API_KEY=""

# Postgres connection string (read-only role recommended for the Streamlit app)
# Shares DB with artifacts/landing/ — see Drizzle schema there.
DATABASE_URL="postgres://readonly_user:password@host:5432/biocycle"

# Where Chroma persists the RAG index between runs
CHROMA_PERSIST_DIR="./.chroma"

LOG_LEVEL="INFO"

# --- OpenRouter (opcional, útil en dev) ---
# OpenRouter expone muchos LLMs vía API OpenAI-compatible. Modelos gratis verificados (2026-04):
#   openrouter/free           — auto-router al mejor modelo gratuito disponible
#   openai/gpt-oss-120b:free  — 120B parámetros, slow pero decente
#   nvidia/nemotron-3-super-120b-a12b:free
#   google/gemma-4-31b-it:free
# Muchos modelos "free" tienen rate limits pesados — si ves 429s, baja a openrouter/free.
# Para producción recomendamos Anthropic Claude directo.
OPENROUTER_API_KEY=""
LLM_PROVIDER="auto"  # "anthropic" | "openrouter" | "auto"
OPENROUTER_CHAT_MODEL="openrouter/free"
OPENROUTER_CLASSIFIER_MODEL="openai/gpt-oss-120b:free"
OPENROUTER_SYNTHESIZER_MODEL="openrouter/free"
ANTHROPIC_CHAT_MODEL="claude-sonnet-4-6"
