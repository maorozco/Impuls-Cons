# Replit configuration · Impulso BioCycle monorepo
#
# ── SINGLE PUBLIC SERVICE ────────────────────────────────────────────
# This Repl publishes exactly ONE external service:
#   • Next.js landing (public port 3000 → external 80)
#
# Internally, scripts/replit-start.sh also spawns a loopback-only helper:
#   • FastAPI ml-api  (127.0.0.1:5001 — NOT exposed, not a public service)
#
# DO NOT add a second service via [[services]] or .replit-artifact/.
# The old Streamlit app at artifacts/impulso-biocycle/ is legacy — it must
# never be deployed to Replit production. If you see Streamlit loading at
# any path (e.g. /app), a multi-service artifact.toml was reintroduced;
# delete it.
#
# Postgres provisioned via Replit "Database" tab → DATABASE_URL auto-injected.
# See REPLIT-AGENT-HANDOFF.md for deploy steps.

modules = ["nodejs-20", "python-3.11", "postgresql-16"]
hidden = [".next", "node_modules", ".venv", ".env.local", ".pnpm-store"]

[nix]
channel = "stable-24_05"
packages = ["glibcLocales"]

[env]
NEXT_TELEMETRY_DISABLED = "1"
# ML_API_URL defaults to loopback inside the Repl. Override only for split deploys.
ML_API_URL = "http://127.0.0.1:5001"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

# ─── Workspace workflow (dev only · "Run" button) ───────────────────
[workflows]
runButton = "dev"

[[workflows.workflow]]
name = "dev"
mode = "parallel"
author = "claude"

  [[workflows.workflow.tasks]]
  task = "shell.exec"
  args = "cd artifacts/ml-api && python main.py --host 127.0.0.1 --port 5001"

  [[workflows.workflow.tasks]]
  task = "shell.exec"
  args = "cd artifacts/landing && pnpm dev"
  waitForPort = 3000

[workflows.workflow.metadata]
outputType = "webview"

# ─── Production Deployment (Reserved VM Shared Medium) ──────────────
[deployment]
deploymentTarget = "gce"
build = ["bash", "scripts/replit-build.sh"]
run = ["bash", "scripts/replit-start.sh"]
ignorePorts = false

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081
